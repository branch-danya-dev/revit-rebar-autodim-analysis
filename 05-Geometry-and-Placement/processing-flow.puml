@startuml
title Rebar AutoDim — Processing Flow

skinparam shadowing false

start

:Read active Revit view;

if (Supported view?) then (Yes)

  :Collect visible Area Reinforcement;
  :Collect and classify structural grids;

  if (Supported zones found?) then (Yes)

    :Select next zone;

    while (More zones?) is (Yes)

      :Read reinforcement boundary;

      if (Valid rectangular geometry?) then (Yes)

        :Project geometry to view coordinates;
        :Build normalized ZoneGeometry;

        :Find nearest valid grids
        for Left / Right / Above / Below;

        :Calculate overall dimensions;
        :Calculate grid offset dimensions;

        :Calculate dimension placement
        and offset levels;

        :Remove previous generated result;

        :Create supporting detail geometry;
        :Create native Revit dimensions;
        :Store generation metadata;

      else (No)

        :Skip zone;

      endif

      :Select next zone;

    endwhile (No)

    :Report processing result;

  else (No)

    :Report no supported zones found;

  endif

else (No)

  :Report unsupported view;

endif

stop

@enduml